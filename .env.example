# 二选一。两把 key 都有时，再设 AGENT_PROVIDER=anthropic 或 openai。

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI 以及兼容接口（DeepSeek、通义、OpenRouter 等）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# default | acceptEdits | plan | bypassPermissions | dontAsk | auto
AGENT_PERMISSION_MODE=default
# AUTO_MODEL=deepseek-chat
AGENT_MAX_TURNS=25

# 上下文压缩。自动阈值 = AGENT_CONTEXT_WINDOW - 20000 - 13000
# AGENT_CONTEXT_WINDOW=128000
# 只关自动压缩；/compact 仍然可用
# DISABLE_AUTO_COMPACT=1
# 自动和手动都停
# DISABLE_COMPACT=1

# 上下文折叠：旧轮次读时替换成 <collapsed> 占位摘要，原文保留
# AGENT_CONTEXT_COLLAPSE=1
# DISABLE_COLLAPSE=1

# 链路追踪遥测(默认开,上报到 trace-server)
# AGENT_TRACE=0                关闭
# AGENT_TRACE_URL=http://127.0.0.1:4120
# AGENT_TRACE_BROKERS=127.0.0.1:9092   直连 Kafka(优先于 URL)
# AGENT_TRACE_TOPIC=agent.trace.spans
# AGENT_TRACE_QUEUE_SIZE=2048
# AGENT_TRACE_BATCH_SIZE=50
# AGENT_TRACE_FLUSH_MS=2000
